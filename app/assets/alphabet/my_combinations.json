  "stacking_rules": {
    "description_ko": "미얀마어는 자음 + virama (◌်) + 자음 결합 시 두 자음이 위·아래로 stacked 되어 한 묶음처럼 보입니다. Pali origin 차용어에 자주 등장.",
    "examples": [
      {"chain": "က + ် + က", "result": "က္က", "rom": "kk", "note": "Pali·외래어 차용 시 흔함"},
      {"chain": "မ + ် + ဘ", "result": "မ္ဘ", "rom": "mb", "common_word": {"word": "ကမ္ဘာ", "ko": "세계·지구"}},
      {"chain": "ပ + ် + ပ", "result": "ပ္ပ", "rom": "pp", "common_word": {"word": "ဥပ္ပါတ်", "ko": "사건 (Pali)"}},
      {"chain": "စ + ် + စ", "result": "စ္စ", "rom": "ss", "common_word": {"word": "ကိစ္စ", "ko": "일·사정 (Pali)"}},
      {"chain": "န + ် + တ", "result": "န္တ", "rom": "nt", "common_word": {"word": "မန္တလေး", "ko": "만달레이 (도시)"}}
    ],
    "korean_learner_note": "한국어 받침 'ㄱ + ㄱ → ㄲ' 같은 결합과 다릅니다. 미얀마는 두 자음 모양을 그대로 위·아래로 쌓아 표시. 첫 자음에 virama (◌်, athat) 가 붙어 '받침' 역할, 둘째 자음이 '초성' 역할."
  },
  "position_misconception": {
    "title_ko": "오해 주의 — 위치별 글자 모양 변화 X",
    "body_ko": "아랍어와 달리 미얀마어 자음은 단어의 어두·어중·어말 위치에 따라 모양이 변하지 않습니다. 시각적 변화는 medial sign (ျ ြ ွ ှ) 과 모음 부호 (ာ ိ ု ေ 등) 결합 시에만 발생합니다. AR 알파벳 학습 후 미얀마 학습 시 이 차이 명심.",
    "comparison_with_arabic": {
      "arabic_pattern": "한 글자 × 4 모양 (단독·어두·어중·어말)",
      "myanmar_pattern": "한 글자 × 1 기본 모양 + medial/모음 결합 시 시각 확장"
    }
  }
